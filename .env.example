# Application Environment
NODE_ENV=development

# Server Configuration
PORT=3000

# Authentication Token (REQUIRED)
# Generate a strong random token for production
TOKEN=your_secret_token_change_this_in_production

# MongoDB Configuration
# For development with Docker MongoDB: mongodb://mongodb:27017
# For local development: mongodb://127.0.0.1:27017
# For production with existing MongoDB on host: mongodb://127.0.0.1:27017
# For production with MongoDB auth: mongodb://username:password@127.0.0.1:27017
# For remote MongoDB: mongodb://username:password@your-mongo-server:27017
MONGODB_URI=mongodb://mongodb:27017
MONGODB_DATABASE=database-name

# Docker MongoDB Container Authentication (only needed if using Docker MongoDB in production)
# Uncomment if you want to secure the Docker MongoDB container:
# MONGO_INITDB_ROOT_USERNAME=admin
# MONGO_INITDB_ROOT_PASSWORD=secure_password_here
